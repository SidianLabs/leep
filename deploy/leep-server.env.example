# Environment for leep-server, read by deploy/systemd/leep-server.service
# from /etc/leep/leep-server.env. It holds the database password: keep it
# mode 0640, owner root, group leep.
#
# Every LEEP_ variable leep-server reads is listed: the ones a production
# install needs are set, the rest are commented out at their defaults
# (`leep-server --help` has the full text of each). Lists are
# comma-separated; durations take ms, s, m, h. Quote values with `?` or `&`
# so the file can also be sourced by a shell; the subcommands (gc, backup,
# migrate, ...) and `leep-git import` need the same LEEP_META and LEEP_BLOBS:
#
#   sudo -u leep sh -c 'set -a; . /etc/leep/leep-server.env; leep-server migrate --status'
#
# Variables are read once at start: restart after changing this file.
# SIGHUP (`systemctl reload`) re-reads only the tokens, signing keys and
# review policy files.

## Stores

# Metadata store: postgres://, sqlite: or mem:// (tests only). The server
# creates its tables on first start.
LEEP_META="postgres://leep:change-me@127.0.0.1:5432/leep"
# Blob store: file:///dir, s3://bucket?region=R (credentials from the
# standard AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY), or mem://.
LEEP_BLOBS="file:///var/lib/leep/blobs"
# Refuse to start while schema migrations are pending instead of applying
# them; run `leep-server migrate` by hand. For a change window, or a
# database account that may not alter the schema.
#LEEP_NO_MIGRATE=1
# Postgres connections this process may open; keep the sum over every server
# and tool under the database's max_connections.
#LEEP_META_POOL_SIZE=16
# Bound on each Postgres statement. Default: LEEP_REQUEST_TIMEOUT plus 5s.
#LEEP_META_STATEMENT_TIMEOUT=

## Listening and monitoring

# Keep it on loopback behind a TLS-terminating proxy; leep-server never
# terminates TLS. A non-loopback address needs LEEP_TOKENS_FILE.
LEEP_LISTEN=127.0.0.1:7070
# Unauthenticated Prometheus /metrics listener. Keep it private.
LEEP_METRICS_LISTEN=127.0.0.1:9187
# text or json (one object per line, for a log pipeline).
#LEEP_LOG_FORMAT=text
# Log filter (tracing EnvFilter syntax).
#RUST_LOG=info
# How long GET /v1/ready waits for each store.
#LEEP_READY_TIMEOUT=2s

## Authentication and policy (files are re-read on SIGHUP)

# Tokens file; enables authentication. Make it with `leep-server gen-token`.
LEEP_TOKENS_FILE=/etc/leep/tokens.json
# Serve without authentication on a non-loopback address. Never in
# production unless a proxy in front authenticates every request.
#LEEP_INSECURE_NO_AUTH=0
#LEEP_SIGNING_KEYS_FILE=/etc/leep/signing-keys.json
#LEEP_REQUIRE_SIGNATURES=main
#LEEP_REVIEW_POLICY_FILE=/etc/leep/review-policy.json
#LEEP_REQUIRE_REVIEW=main
# Refs that only move forward and cannot be deleted.
#LEEP_PROTECT_REFS=main

## Request limits (DEPLOY.md, "Request limits" and "Body limits")

# Abort requests that run longer; 0 disables. `gc --fence` must exceed it.
#LEEP_REQUEST_TIMEOUT=5m
#LEEP_RATE_LIMIT=
#LEEP_RATE_BURST=
#LEEP_MAX_CONCURRENT_PER_TOKEN=
#LEEP_READ_MAX_BODY_BYTES=1048576
#LEEP_MAX_BODY_BYTES=536870912
#LEEP_MAX_BLOB_BYTES=268435456
#LEEP_MAX_JSON_BODY_BYTES=33554432
#LEEP_MAX_INFLIGHT_BYTES=1073741824
# CLASS=N or CLASS=off, e.g. search=4. Default: search at half the cores.
#LEEP_READ_CONCURRENCY=
# Default: a quarter of LEEP_META_POOL_SIZE.
#LEEP_SEARCH_POOL_PERMITS=
# N or off. Set off while clients older than #143 remain (they do not
# resend a refused land).
#LEEP_LAND_QUEUE_BATCHES=4

## Indexing and caches (OPERATIONS.md, "Indexing a large history")

#LEEP_DERIVE_CACHE_BYTES=423624704
#LEEP_WARM_INTERVAL=250ms
#LEEP_WARM_SEARCH=true
# Default: the cores, up to 8.
#LEEP_DERIVE_JOBS=
# local, lease or off.
#LEEP_INDEXING=local
# history, log-filter, search (lease mode). Default: all.
#LEEP_INDEX_KINDS=
#LEEP_QUERY_SCAN_BUDGET=1024
#LEEP_BLAME_SCAN_BUDGET=128
#LEEP_SEARCH_SCAN_BUDGET=512
#LEEP_SEARCH_SCAN_BYTES=16777216
#LEEP_LEGACY_SCAN_FACTOR=8
#LEEP_INDEX_WAIT=10s
#LEEP_INDEX_WAITERS=64

## Several servers on one metadata store (OPERATIONS.md, "Several servers on one ref")

#LEEP_LAND_COORDINATION=off
#LEEP_ADVERTISE_URL=http://10.0.3.7:7070
#LEEP_PEER_URL_PREFIX=http://10.0.3.
#LEEP_PEER_CIDR=10.0.0.0/16
#LEEP_PEER_ALLOW_PLAIN_HTTP=false
#LEEP_LAND_LEASE_TTL=2s
#LEEP_LAND_LEASE_RENEW=500ms
